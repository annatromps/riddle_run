<%= form_with model: [:admin, riddle], class: "space-y-5 max-w-2xl" do |f| %>
  <% if riddle.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg px-4 py-3 text-red-700 text-sm">
      <% riddle.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :question, class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_area :question, rows: 3,
          class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-black" %>
  </div>

  <div>
    <%= f.label :answer, class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_field :answer,
          class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-black" %>
  </div>

  <div>
    <%= f.label :hint, "Hint (optional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_area :hint, rows: 2,
          class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-black" %>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div>
      <%= f.label :difficulty, class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.select :difficulty, Riddle::DIFFICULTIES,
            { prompt: "Pick one" },
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-black" %>
    </div>

    <div>
      <%= f.label :category, "Category (optional)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :category, placeholder: "e.g. wordplay",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-black" %>
    </div>

    <div>
      <%= f.label :thinking_seconds, "Thinking time (s)", class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%= f.number_field :thinking_seconds, min: 5, max: 120,
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-black" %>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :published, class: "rounded border-gray-300" %>
    <%= f.label :published, "Published (visible in runs)", class: "text-sm text-gray-700" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit riddle.persisted? ? "Save changes" : "Create riddle",
          class: "bg-black text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-gray-800 cursor-pointer" %>
    <%= link_to "Cancel", admin_riddles_path, class: "text-sm text-gray-500 hover:underline" %>
  </div>
<% end %>
