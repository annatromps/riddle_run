<div class="max-w-5xl mx-auto px-6 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Riddles <span class="text-gray-400 font-normal text-lg">(<%= Riddle.count %>)</span></h1>
    <%= link_to "New riddle", new_admin_riddle_path, class: "bg-black text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-gray-800" %>
  </div>

  <% if notice.present? %>
    <p class="bg-green-50 border border-green-200 text-green-800 rounded-lg px-4 py-2 mb-4 text-sm"><%= notice %></p>
  <% end %>

  <div class="border border-gray-200 rounded-xl overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="text-left px-4 py-3 font-semibold text-gray-600">Question</th>
          <th class="text-left px-4 py-3 font-semibold text-gray-600 w-24">Difficulty</th>
          <th class="text-left px-4 py-3 font-semibold text-gray-600 w-20">Secs</th>
          <th class="text-left px-4 py-3 font-semibold text-gray-600 w-20">Published</th>
          <th class="w-20"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @riddles.each do |riddle| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-gray-900 max-w-xs">
              <p class="truncate"><%= riddle.question %></p>
              <p class="text-gray-400 text-xs truncate mt-0.5"><%= riddle.answer %></p>
            </td>
            <td class="px-4 py-3">
              <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded-full
                <%= riddle.difficulty == 'easy' ? 'bg-green-100 text-green-800' :
                    riddle.difficulty == 'medium' ? 'bg-yellow-100 text-yellow-800' :
                    'bg-red-100 text-red-800' %>">
                <%= riddle.difficulty %>
              </span>
            </td>
            <td class="px-4 py-3 text-gray-500"><%= riddle.thinking_seconds %>s</td>
            <td class="px-4 py-3">
              <%= riddle.published? ? "✓" : "–" %>
            </td>
            <td class="px-4 py-3 text-right">
              <%= link_to "Edit", edit_admin_riddle_path(riddle), class: "text-blue-600 hover:underline mr-3" %>
              <%= button_to "Delete", admin_riddle_path(riddle), method: :delete,
                    data: { turbo_confirm: "Delete this riddle?" },
                    class: "text-red-500 hover:underline text-sm bg-transparent border-none cursor-pointer p-0" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
