<% riddle   = @attempt.riddle %>
<% total    = @run.attempts.count %>
<% position = @attempt.position + 1 %>

<div class="min-h-full flex flex-col px-5 pt-10 pb-8 max-w-sm mx-auto"
     data-controller="puzzle"
     data-puzzle-audio-value="<%= @run.audio_enabled %>"
     data-puzzle-timed-value="<%= @run.timed %>"
     data-puzzle-seconds-value="<%= @run.seconds_per_puzzle %>"
     data-puzzle-auto-advance-value="<%= @run.auto_advance %>">

  <%# Hidden advance form %>
  <form action="<%= run_attempt_path(@run, @attempt) %>" method="post"
        data-puzzle-target="form" class="hidden">
    <input type="hidden" name="_method" value="patch">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <input type="hidden" name="outcome" value="skipped" data-puzzle-target="outcomeField">
  </form>

  <%# Progress %>
  <div class="flex items-center mb-10">
    <span class="text-zinc-600 text-sm font-medium tabular-nums">
      <%= position %> / <%= total %>
    </span>
  </div>

  <%# Question — owns the screen %>
  <div class="flex-1 flex flex-col justify-center gap-8">
    <div class="relative py-8 cursor-pointer"
         data-action="click->puzzle#replayQuestion">
      <%# Faint tap-hint circle %>
      <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 flex justify-center pointer-events-none">
        <div class="w-72 h-72 rounded-full bg-white/[0.03] border border-white/[0.05]"></div>
      </div>
      <div class="relative">
        <p class="font-black leading-tight tracking-tight"
           style="font-size: clamp(2rem, 9vw, 3.25rem);"
           data-puzzle-target="question">
          <%= riddle.question %>
        </p>
        <p class="text-zinc-700 text-sm mt-4">Keep running. Keep thinking.</p>
      </div>
    </div>

    <%# Timer (only rendered when run is timed) %>
    <% if @run.timed %>
      <div class="flex items-center gap-5">

        <%# SVG ring %>
        <div class="relative w-16 h-16 flex-shrink-0">
          <svg viewBox="0 0 36 36" class="w-16 h-16 -rotate-90" aria-hidden="true">
            <circle cx="18" cy="18" r="15.9"
                    fill="none" stroke="#27272a" stroke-width="2.8"/>
            <circle cx="18" cy="18" r="15.9"
                    fill="none" stroke="#fbbf24" stroke-width="2.8"
                    stroke-dasharray="100" stroke-dashoffset="100"
                    stroke-linecap="round"
                    data-puzzle-target="timerRing"/>
          </svg>
          <span class="absolute inset-0 flex items-center justify-center
                       font-bold tabular-nums text-sm text-white"
                data-puzzle-target="timerDisplay">
            0
          </span>
        </div>

        <button type="button"
                data-action="click->puzzle#togglePause"
                data-puzzle-target="pauseBtn"
                class="text-zinc-500 text-sm font-semibold border border-zinc-800
                       rounded-xl px-5 py-2.5 active:bg-zinc-800 transition-colors">
          Pause
        </button>

      </div>
    <% end %>

    <%# Answer section — hidden until reveal %>
    <div class="hidden items-start border-l-2 border-amber-400 pl-4 relative py-6 cursor-pointer"
         data-puzzle-target="answerSection"
         data-answer="<%= riddle.answer %>"
         data-action="click->puzzle#replayAnswer">
      <%# Faint tap-hint circle %>
      <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 flex justify-center pointer-events-none">
        <div class="w-60 h-60 rounded-full bg-amber-400/[0.04] border border-amber-400/[0.06]"></div>
      </div>
      <div class="relative">
        <p class="text-xs uppercase tracking-widest text-zinc-500 mb-1">Answer</p>
        <p class="text-2xl font-bold leading-snug"><%= riddle.answer %></p>
      </div>
    </div>

  </div>

  <%# Action buttons %>
  <div class="flex gap-3 pt-8">
    <button type="button"
            data-action="click->puzzle#reveal"
            class="flex-1 border border-zinc-800 text-zinc-500 font-semibold
                   py-5 rounded-2xl active:border-zinc-600 active:text-zinc-300
                   transition-colors text-sm">
      Show answer
    </button>
    <button type="button"
            data-action="click->puzzle#next"
            class="flex-[2] bg-amber-400 text-zinc-950 font-bold text-xl
                   py-5 rounded-2xl active:scale-95 transition-transform tracking-tight">
      Next →
    </button>
  </div>

</div>
