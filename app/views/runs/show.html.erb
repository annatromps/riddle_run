<% riddle = @attempt.riddle %>
<% total  = @run.attempts.count %>
<% done   = @run.attempts.completed.count %>

<div class="min-h-screen flex flex-col px-6 py-10 max-w-lg mx-auto">

  <%# Progress %>
  <div class="flex items-center justify-between text-zinc-500 text-sm mb-8">
    <span>Riddle <%= done + 1 %> of <%= total %></span>
    <span class="text-zinc-600"><%= @run.difficulty.capitalize %></span>
  </div>

  <%# Question %>
  <div class="flex-1 flex flex-col justify-center space-y-8">
    <p class="text-3xl font-bold leading-snug"><%= riddle.question %></p>

    <%# Timer placeholder — replaced by timer_controller in step 8 %>
    <div class="flex items-center gap-3 text-zinc-400">
      <div class="w-12 h-12 rounded-full border-2 border-zinc-700 flex items-center justify-center font-mono text-lg">
        <%= riddle.thinking_seconds %>
      </div>
      <span class="text-sm">seconds to think</span>
    </div>

    <%# Hint %>
    <% if riddle.hint.present? %>
      <details class="group">
        <summary class="cursor-pointer text-zinc-500 text-sm select-none list-none flex items-center gap-2">
          <span class="border border-zinc-700 rounded-lg px-3 py-1.5 group-open:border-zinc-500 transition-colors">
            Hint
          </span>
        </summary>
        <p class="mt-3 text-zinc-300 text-lg"><%= riddle.hint %></p>
      </details>
    <% end %>

    <%# Answer reveal %>
    <details class="group">
      <summary class="cursor-pointer select-none list-none">
        <span class="border border-zinc-700 text-zinc-400 rounded-lg px-4 py-2.5 text-sm
                     group-open:hidden inline-block transition-colors">
          Reveal answer
        </span>
      </summary>
      <div class="mt-3 bg-zinc-800 rounded-2xl px-5 py-4 border border-zinc-700">
        <p class="text-zinc-400 text-xs uppercase tracking-widest mb-1">Answer</p>
        <p class="text-2xl font-bold"><%= riddle.answer %></p>
      </div>
    </details>
  </div>

  <%# Outcome buttons %>
  <div class="space-y-3 pt-8">
    <%= button_to "✓  Got it", run_attempt_path(@run, @attempt),
          params: { outcome: "correct" },
          method: :patch,
          class: "w-full bg-green-600 hover:bg-green-500 text-white font-bold text-xl py-5 rounded-2xl active:scale-95 transition-all" %>

    <%= button_to "✗  Nope", run_attempt_path(@run, @attempt),
          params: { outcome: "wrong" },
          method: :patch,
          class: "w-full bg-zinc-800 hover:bg-zinc-700 text-white font-bold text-xl py-5 rounded-2xl active:scale-95 transition-all" %>

    <%= button_to "Skip", run_attempt_path(@run, @attempt),
          params: { outcome: "skipped" },
          method: :patch,
          class: "w-full text-zinc-600 font-medium py-3 rounded-2xl active:scale-95 transition-all text-sm" %>
  </div>

</div>
