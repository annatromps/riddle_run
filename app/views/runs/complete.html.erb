<% total   = @attempts.count %>
<% correct = @attempts.count { |a| a.outcome == "correct" } %>
<% pct     = total > 0 ? (correct * 100.0 / total).round : 0 %>

<div class="min-h-screen flex flex-col items-center px-6 py-12 max-w-lg mx-auto">

  <div class="text-center space-y-2 mb-10">
    <p class="text-5xl mb-2"><%= pct >= 80 ? "🏅" : pct >= 50 ? "💪" : "🤔" %></p>
    <h1 class="text-4xl font-black">Run complete!</h1>
    <p class="text-zinc-400 text-lg">
      <%= correct %> of <%= total %> correct
      <span class="text-zinc-600 ml-1">(<%= pct %>%)</span>
    </p>
  </div>

  <div class="w-full space-y-3 mb-10">
    <% @attempts.each do |attempt| %>
      <div class="flex items-start gap-4 bg-zinc-900 rounded-2xl px-4 py-3 border border-zinc-800">
        <span class="mt-0.5 text-lg leading-none">
          <%= { "correct" => "✓", "wrong" => "✗", "revealed" => "👁", "skipped" => "—" }[attempt.outcome] || "?" %>
        </span>
        <div class="flex-1 min-w-0">
          <p class="text-sm text-zinc-300 leading-snug"><%= attempt.riddle.question %></p>
          <p class="text-xs text-zinc-600 mt-1"><%= attempt.riddle.answer %></p>
        </div>
      </div>
    <% end %>
  </div>

  <%= link_to "New run →", new_run_path,
        class: "w-full block text-center bg-white text-zinc-950 font-black text-xl py-5 rounded-2xl active:scale-95 transition-transform" %>

</div>
