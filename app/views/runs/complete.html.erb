<div class="min-h-screen flex flex-col items-center justify-center px-5 text-center max-w-sm mx-auto">

  <p class="text-6xl mb-6">🏁</p>
  <h1 class="text-5xl font-bold tracking-tight leading-none mb-3">Done!</h1>
  <p class="text-zinc-500 text-lg mb-12">
    You ran through <%= @attempts.count %> puzzle<%= @attempts.count == 1 ? "" : "s" %>.
  </p>

  <%= link_to new_run_path,
        class: "w-full block bg-amber-400 text-zinc-950 font-bold text-xl py-5 rounded-2xl active:scale-95 transition-transform tracking-tight" do %>
    Run again →
  <% end %>

</div>
