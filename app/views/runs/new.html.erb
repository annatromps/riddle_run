<% puzzle_count = Run::PUZZLES_PER_RUN %>

<div class="h-dvh flex flex-col px-5 pt-5 pb-5 max-w-sm mx-auto">

  <%# Pill badge %>
  <div class="mb-3 flex-shrink-0">
    <span class="inline-flex items-center gap-2 bg-zinc-900 border border-zinc-800
                 text-zinc-400 text-xs font-bold px-3 py-1.5 rounded-full tracking-widest uppercase">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
      Daily Run &middot; <%= puzzle_count %>
    </span>
  </div>

  <%# Hero %>
  <div class="relative mb-4 flex-shrink-0">
    <div class="absolute -top-4 -left-10 w-64 h-36
                bg-amber-500/10 blur-3xl rounded-full pointer-events-none"></div>
    <div class="relative">
      <h1 class="font-black uppercase leading-[0.85] tracking-tight"
          style="font-size: clamp(2.75rem, 14vw, 4rem);">
        <span class="text-white block">RIDDLE</span>
        <span class="text-amber-400 block">RUN</span>
      </h1>
      <p class="text-zinc-500 mt-2 text-sm leading-snug max-w-[240px]">
        Hard puzzles for long runs. No rush.
      </p>
    </div>
  </div>

  <%= form_with url: runs_path, method: :post,
        data: { controller: "setup" },
        class: "flex-1 flex flex-col gap-3 min-h-0" do %>

    <%# Question style cards %>
    <div class="flex-shrink-0">
      <p class="text-xs uppercase tracking-widest text-zinc-600 font-semibold mb-2">Question style</p>
      <div class="grid grid-cols-3 gap-2">
        <% [
             ["word_puzzles", "🔤", "Word",    "Classic puzzles"],
             ["cryptic",      "🧩", "Cryptic", "Crossword style"],
             ["mix",          "🎲", "Mix",     "Blend of both"]
           ].each_with_index do |(value, icon, label, sublabel), i| %>
          <label class="cursor-pointer group">
            <input type="radio" name="question_style" value="<%= value %>"
                   class="sr-only" <%= i == 0 ? "checked" : "" %>>
            <div class="border border-zinc-800 rounded-2xl p-2.5 text-center transition-all duration-150
                        group-has-[input:checked]:border-amber-400/60
                        group-has-[input:checked]:bg-amber-400/[0.05]">
              <p class="text-lg mb-1"><%= icon %></p>
              <p class="font-bold text-sm text-white leading-tight"><%= label %></p>
              <p class="text-zinc-600 text-[11px] mt-0.5 leading-tight"><%= sublabel %></p>
              <p class="text-amber-400 text-xs font-black mt-1.5 h-3
                        opacity-0 group-has-[input:checked]:opacity-100 transition-opacity">✓</p>
            </div>
          </label>
        <% end %>
      </div>
    </div>

    <%# Options card %>
    <div class="flex-shrink-0 rounded-2xl border border-zinc-800 overflow-hidden divide-y divide-zinc-800 bg-zinc-900/50">

      <%# Audio row %>
      <div class="flex items-center gap-3 px-4 py-3">
        <div class="w-8 h-8 rounded-xl bg-zinc-800 flex items-center justify-center flex-shrink-0">
          <span class="text-sm">🔊</span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-sm text-white">Audio</p>
          <p class="text-zinc-600 text-xs mt-0.5">Read questions aloud</p>
        </div>
        <div class="relative w-12 h-6 flex-shrink-0">
          <input type="checkbox" name="audio_enabled" value="1" id="audio_enabled"
                 class="sr-only peer" checked>
          <label for="audio_enabled"
                 class="absolute inset-0 rounded-full bg-zinc-700 peer-checked:bg-amber-400 transition-colors duration-200 cursor-pointer"></label>
          <div class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow-sm
                      transition-transform duration-200 peer-checked:translate-x-6 pointer-events-none"></div>
        </div>
      </div>

      <%# Timer row %>
      <div class="flex items-center gap-3 px-4 py-3">
        <div class="w-8 h-8 rounded-xl bg-zinc-800 flex items-center justify-center flex-shrink-0">
          <span class="text-sm">⏱</span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-sm text-white">Timer</p>
          <p class="text-zinc-600 text-xs mt-0.5">Count up while you think</p>
        </div>
        <div class="relative w-12 h-6 flex-shrink-0">
          <input type="checkbox" name="timed" value="1" id="timed"
                 class="sr-only peer"
                 data-action="change->setup#timedChanged">
          <label for="timed"
                 class="absolute inset-0 rounded-full bg-zinc-700 peer-checked:bg-amber-400 transition-colors duration-200 cursor-pointer"></label>
          <div class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow-sm
                      transition-transform duration-200 peer-checked:translate-x-6 pointer-events-none"></div>
        </div>
      </div>

      <%# Timed sub-options — hidden until timer is on %>
      <div data-setup-target="timedOptions" class="hidden divide-y divide-zinc-800/60">

        <%# Seconds slider %>
        <div class="px-4 py-3 bg-zinc-950/50">
          <div class="flex items-center justify-between mb-2">
            <p class="font-semibold text-sm text-white">Seconds per puzzle</p>
            <span class="text-amber-400 font-bold tabular-nums text-sm"
                  data-setup-target="secondsDisplay">30</span>
          </div>
          <input type="range" name="seconds_per_puzzle"
                 min="10" max="90" value="30" step="5"
                 data-action="input->setup#secondsChanged">
          <div class="flex justify-between text-zinc-700 text-xs mt-1.5">
            <span>10s</span><span>90s</span>
          </div>
        </div>

        <%# Auto-advance row %>
        <div class="flex items-center gap-3 px-4 py-3 bg-zinc-950/50">
          <div class="w-8 h-8 rounded-xl bg-zinc-800 flex items-center justify-center flex-shrink-0">
            <span class="text-sm">⏭</span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-semibold text-sm text-white">Auto-advance</p>
            <p class="text-zinc-600 text-xs mt-0.5">Move on when timer hits zero</p>
          </div>
          <div class="relative w-12 h-6 flex-shrink-0">
            <input type="checkbox" name="auto_advance" value="1" id="auto_advance"
                   class="sr-only peer" checked>
            <label for="auto_advance"
                   class="absolute inset-0 rounded-full bg-zinc-700 peer-checked:bg-amber-400 transition-colors duration-200 cursor-pointer"></label>
            <div class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow-sm
                        transition-transform duration-200 peer-checked:translate-x-6 pointer-events-none"></div>
          </div>
        </div>

      </div>

    </div>

    <%# Spacer — absorbs remaining space so button stays at bottom %>
    <div class="flex-1"></div>

    <%# Bottom info bar %>
    <div class="flex items-center justify-between text-xs font-medium flex-shrink-0">
      <span class="flex items-center gap-1.5 text-zinc-600">
        🔥 <span>3-day streak</span>
      </span>
      <span class="text-zinc-700">
        <%= puzzle_count %> puzzles &middot; ~<%= (puzzle_count * 30 / 60.0).ceil %> min
      </span>
    </div>

    <%# Start button %>
    <button type="submit"
            class="w-full font-black text-xl py-4 rounded-full flex-shrink-0
                   active:scale-95 transition-transform tracking-tight text-zinc-950"
            style="background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
                   box-shadow: 0 0 28px rgba(251,191,36,0.22);">
      Start Run →
    </button>

  <% end %>

</div>
