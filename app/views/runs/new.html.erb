<% puzzle_count = Run::PUZZLES_PER_RUN %>

<div class="h-dvh flex flex-col px-6 max-w-sm mx-auto"
     data-controller="info"
     style="padding-top: clamp(1.25rem, 4vh, 2.5rem); padding-bottom: clamp(1.25rem, 4vh, 2rem);">

  <%# Info modal (fixed overlay, hidden by default) %>
  <div data-info-target="modal"
       data-action="click->info#dismissIfBackground"
       class="hidden fixed inset-0 z-50 bg-black/60 flex items-center justify-center px-8">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-xs">
      <p class="text-xs uppercase tracking-widest text-zinc-500 font-semibold mb-4">Controls</p>
      <ul class="space-y-3 text-sm text-zinc-300">
        <li class="flex items-start gap-3">
          <span class="text-zinc-600 mt-0.5">○</span>
          <span>Tap the circle to replay audio</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-zinc-600 mt-0.5">◦</span>
          <span>Say &#8220;next&#8221; to advance</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-zinc-600 mt-0.5">◦</span>
          <span>Say &#8220;answer&#8221; to reveal</span>
        </li>
      </ul>
      <p class="text-zinc-700 text-xs text-center mt-5">tap anywhere to dismiss</p>
    </div>
  </div>

  <%# Info button %>
  <div class="mb-[3vh] flex-shrink-0 flex items-center justify-end">
    <button type="button"
            data-action="click->info#show"
            class="w-8 h-8 rounded-full border-2 border-zinc-500 text-zinc-200
                   font-black text-sm flex items-center justify-center flex-shrink-0
                   -mr-2 active:border-zinc-300 active:text-white transition-colors">
      i
    </button>
  </div>

  <%# Hero %>
  <div class="relative mb-[3vh] flex-shrink-0">
    <div class="absolute -top-6 -left-10 w-72 h-48
                bg-amber-500/10 blur-3xl rounded-full pointer-events-none"></div>
    <div class="relative">
      <h1 class="font-black uppercase leading-[0.72] tracking-tight"
          style="font-size: clamp(3.25rem, 17vw, 5rem);">
        <span class="text-white block">RIDDLE</span>
        <span class="text-amber-400 block">RUN</span>
      </h1>
      <p class="text-zinc-500 leading-snug max-w-[260px]"
         style="margin-top: clamp(0.5rem, 1.5vh, 1rem); font-size: clamp(0.875rem, 2vh, 1rem);">
        Hard puzzles for long runs. No rush.
      </p>
    </div>
  </div>

  <%# Form — justify-between distributes the three sections across remaining space %>
  <%= form_with url: runs_path, method: :post,
        data: { controller: "setup" },
        class: "flex-1 flex flex-col justify-between min-h-0" do %>

    <%# Question style cards %>
    <div class="flex-shrink-0">
      <p class="text-xs uppercase tracking-widest text-zinc-600 font-semibold mb-3">Question style</p>
      <div class="grid grid-cols-3 gap-2">
        <% [
             ["word_puzzles", "🔤", "Word",    "Classic puzzles"],
             ["cryptic",      "🧩", "Cryptic", "Crossword style"],
             ["mix",          "🎲", "Mix",     "Blend of both"]
           ].each_with_index do |(value, icon, label, sublabel), i| %>
          <label class="cursor-pointer group aspect-square">
            <input type="radio" name="question_style" value="<%= value %>"
                   class="sr-only" <%= i == 0 ? "checked" : "" %>>
            <div class="h-full border border-zinc-800 rounded-2xl p-3 text-center transition-all duration-150
                        group-has-[input:checked]:border-amber-400/60
                        group-has-[input:checked]:bg-amber-400/[0.05]">
              <p class="text-xl mb-1.5"><%= icon %></p>
              <p class="font-bold text-sm text-white leading-tight"><%= label %></p>
              <p class="text-zinc-600 text-[11px] mt-0.5 leading-tight"><%= sublabel %></p>

            </div>
          </label>
        <% end %>
      </div>
    </div>

    <%# Options card %>
    <div class="flex-shrink-0 rounded-2xl border border-zinc-800 overflow-hidden divide-y divide-zinc-800 bg-zinc-900/50">

      <%# Audio row %>
      <div class="flex items-center gap-3 px-4 py-3.5">
        <div class="w-9 h-9 rounded-xl bg-zinc-800 flex items-center justify-center flex-shrink-0">
          <span class="text-base">🔊</span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-sm text-white">Audio</p>
          <p class="text-zinc-600 text-xs mt-0.5">Read questions aloud</p>
        </div>
        <div class="relative w-12 h-6 flex-shrink-0">
          <input type="checkbox" name="audio_enabled" value="1" id="audio_enabled"
                 class="sr-only peer" checked>
          <label for="audio_enabled"
                 class="absolute inset-0 rounded-full bg-zinc-700 peer-checked:bg-amber-400 transition-colors duration-200 cursor-pointer"></label>
          <div class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow-sm
                      transition-transform duration-200 peer-checked:translate-x-6 pointer-events-none"></div>
        </div>
      </div>

      <%# Timer row %>
      <div class="flex items-center gap-3 px-4 py-3.5">
        <div class="w-9 h-9 rounded-xl bg-zinc-800 flex items-center justify-center flex-shrink-0">
          <span class="text-base">⏱</span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="font-semibold text-sm text-white">Timer</p>
          <p class="text-zinc-600 text-xs mt-0.5">Count up while you think</p>
        </div>
        <div class="relative w-12 h-6 flex-shrink-0">
          <input type="checkbox" name="timed" value="1" id="timed"
                 class="sr-only peer"
                 data-action="change->setup#timedChanged">
          <label for="timed"
                 class="absolute inset-0 rounded-full bg-zinc-700 peer-checked:bg-amber-400 transition-colors duration-200 cursor-pointer"></label>
          <div class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow-sm
                      transition-transform duration-200 peer-checked:translate-x-6 pointer-events-none"></div>
        </div>
      </div>

      <%# Timed sub-options — hidden until timer is on %>
      <div data-setup-target="timedOptions" class="hidden divide-y divide-zinc-800/60">

        <%# Seconds slider %>
        <div class="px-4 py-3.5 bg-zinc-950/50">
          <div class="flex items-center justify-between mb-3">
            <p class="font-semibold text-sm text-white">Seconds per puzzle</p>
            <span class="text-amber-400 font-bold tabular-nums text-sm"
                  data-setup-target="secondsDisplay">30</span>
          </div>
          <input type="range" name="seconds_per_puzzle"
                 min="10" max="90" value="30" step="5"
                 data-action="input->setup#secondsChanged">
          <div class="flex justify-between text-zinc-700 text-xs mt-2">
            <span>10s</span><span>90s</span>
          </div>
        </div>

        <%# Auto-advance row %>
        <div class="flex items-center gap-3 px-4 py-3.5 bg-zinc-950/50">
          <div class="w-9 h-9 rounded-xl bg-zinc-800 flex items-center justify-center flex-shrink-0">
            <span class="text-base">⏭</span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-semibold text-sm text-white">Auto-advance</p>
            <p class="text-zinc-600 text-xs mt-0.5">Move on when timer hits zero</p>
          </div>
          <div class="relative w-12 h-6 flex-shrink-0">
            <input type="checkbox" name="auto_advance" value="1" id="auto_advance"
                   class="sr-only peer" checked>
            <label for="auto_advance"
                   class="absolute inset-0 rounded-full bg-zinc-700 peer-checked:bg-amber-400 transition-colors duration-200 cursor-pointer"></label>
            <div class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-white shadow-sm
                        transition-transform duration-200 peer-checked:translate-x-6 pointer-events-none"></div>
          </div>
        </div>

      </div>

    </div>

    <%# Bottom bar + button grouped so justify-between pushes them to the bottom %>
    <div class="flex-shrink-0 flex flex-col gap-3">

      <button type="submit"
              class="w-full font-black text-xl py-5 rounded-full
                     active:scale-95 transition-transform tracking-tight text-zinc-950"
              style="background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
                     box-shadow: 0 0 28px rgba(251,191,36,0.22);">
        Start Run →
      </button>

    </div>

  <% end %>

</div>
